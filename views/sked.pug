extends ./layout

block content
  div.info-msg-done(id="info-msg-done")
  br
  .container-sked
    .date
      span График с 
      .from
        span.day(id="day-from")
        span /
        span.month(id="month-from")
        span /
        span.year(id="year-from")
      span.dash-sp &ndash;
      .to
        span по 
        span.day(id="day-to")
        span /
        span.month(id="month-to")
        span /
        span.year(id="year-to") 
    table.sked-table-main
      thead
        tr
          th №
          th Сотрудник
          th.weekdate
          th.weekdate
          th.weekdate
          th.weekdate
          th.weekdate
          th.weekdate
          th.weekdate
          th.weekdate
          th.weekdate
          th.weekdate
          th.weekdate
          th.weekdate
          th.weekdate
          th.weekdate
      tbody(id="sked-main-tb")
        each worker, i in workers
          tr 
            td=i + 1 
            td=worker.username
        tr 
          td X
          td Подрядчик
        
      tfoot
        tr
          td(colspan="16" id="sked-main-foot")
            button(title="Посмотреть предыдущий график" class="new-sked-bt" id="prev-sked-bt" style="display:none;float:left;") Предыдущий график
            button(title="Посмотреть следующий график" class="new-sked-bt" id="next-sked-bt" style="float:left;display:none;") Следующий график
            button(title="Создать новый (пустой) график дежурств" class="new-sked-bt" id="new-sked-bt" style="float:right;") Новый график
            button(title="Сохранить данный график в базу" class="new-sked-bt" id="save-sked-bt" style="float:right;display:none;")
    .modal 
      div Укажите диапазон
  script.
    window.onload = function() {
      
      const workers = !{JSON.stringify(workers)};
      const skeds = !{JSON.stringify(skeds)};
      const skedApp = new SkedApp(workers, skeds);
    };